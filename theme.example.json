{
  // Fonts are declared once and referenced by key everywhere else, so swapping
  // a brand font means editing one line. "family" must match the name inside
  // the font file - leave it out and it is read from the file for you.
  // Every .ttf and .otf in the "fonts" folder beside this file is available by
  // name: "inter", "inter-bold", "space-grotesk", "fraunces-bold" and so on.
  // Declare a font here only to add one from somewhere else, or to give one a
  // key of your own. A key declared here wins over the folder.
  //   "fonts": { "brand": { "family": "Acme Sans", "file": "brand/Acme.ttf", "weight": 700 } },

  // Fade to and from black at the start and end of every segment.
  "transitions": {
    "enabled": true,
    "fadeSec": 0.4
  },

  "cursor": {
    "enabled": true,
    "color": "#FFFFFF",
    "strokeColor": "#000000",
    "size": 28,

    // Drop in your own pointer instead of the drawn arrow. Use a .png with
    // transparency, or a .svg. "hotspot" is the point that lands on the target,
    // as a fraction of the image: [0, 0] is its top-left corner.
    // "image": "assets/cursor.png",
    // "hotspot": [0.19, 0.08],

    // null lets the travel time follow the distance. easing is
    // easeInOut, easeOut or linear.
    "moveMs": null,
    "easing": "easeInOut",

    // A ring that expands and fades where the click lands.
    "ripple": true,
    "rippleColor": null,
    "rippleMs": 620
  },

  "highlight": {
    "enabled": true,
    "color": "#6C5CE7",
    "glow": true,
    "borderWidth": 3,
    "borderRadius": "auto"
  },

  // Small blocks of text that explain a step. Add "hint" to a step in
  // flow.json and it appears on screen while that step plays.
  "hints": {
    "enabled": true,
    "font": "inter",
    "fontSize": 28,
    "color": "#FFFFFF",
    "backgroundColor": "#1A1D29",
    "backgroundOpacity": 1,
    // "none" is a hairline round the whole block; "bar" puts a coloured strip
    // down the left instead.
    "accent": "none",
    "accentColor": "#6C5CE7",
    // null derives the hairline from the text colour, which suits any surface.
    "borderColor": null,
    "borderRadius": 12,
    "maxWidth": 520,
    "padding": 20,
    // "auto" anchors the hint to the element being acted on. The fixed spots
    // are top/bottom crossed with left/center/right.
    "position": "auto",
    "offset": 20,
    "fadeMs": 260
  },

  // Burned-in captions are off unless you ask for them, here or with --captions.
  "captions": {
    "enabled": false,
    "font": "inter",
    "fontSize": 34,
    "color": "#FFFFFF",
    "backgroundColor": "#000000",
    "backgroundOpacity": 0.55,
    "position": "bottom",
    "marginBottom": 60,
    "outline": true
  },

  "intro": {
    "enabled": true,
    "durationSec": 3,
    "backgroundColor": "#0F1115",
    "backgroundGradient": ["#0F1115", "#1A1D29"],
    // "logo": "assets/logo.png",
    "title": "Acme",
    "titleFont": "poppins-bold",
    "subtitle": "Product Walkthrough",
    "subtitleFont": "inter"
  },

  "outro": {
    "enabled": true,
    "durationSec": 3,
    "backgroundColor": "#0F1115",
    "title": "Try it free",
    "titleFont": "poppins-bold",
    "subtitle": "yoursite.com",
    "subtitleFont": "inter"
  },

  "video": { "width": 1920, "height": 1080, "fps": 30, "backgroundColor": "#0F1115" }
}
