{
  // Derived from a screenshot of the portal. The pink is an estimate at
  // #E6007E; replace it with the real brand value, it is one line.
  //
  // Overused Grotesk, SIL Open Font License 1.1. "Roman" is the 400 weight -
  // there is no file called Regular. Both files report the family name
  // "Overused Grotesk", so libass picks between them by weight.
  // Every .ttf and .otf in the "fonts" folder beside this file is available by
  // name: "inter", "inter-bold", "space-grotesk", "fraunces-bold" and so on.
  // Declare a font here only to add one from somewhere else, or to give one a
  // key of your own. A key declared here wins over the folder.
  //   "fonts": { "brand": { "family": "Acme Sans", "file": "brand/Acme.ttf", "weight": 700 } },

  "transitions": { "enabled": true, "fadeSec": 0.35 },

  // White with a black stroke: the page mixes light grey, white, black and pink
  // panels, and any single flat colour disappears against half of them.
  "cursor": {
    "enabled": true,
    "color": "#FFFFFF",
    "strokeColor": "#0A0A0A",
    "size": 30,
    "easing": "easeInOut",
    "ripple": true,
    "rippleColor": "#E6007E",
    "rippleMs": 620
  },

  "highlight": {
    "enabled": true,
    "color": "#E6007E",
    "glow": true,
    "borderWidth": 3,
    "borderRadius": "auto"
  },

  // A quiet dark surface with a hairline edge. Set "accent": "bar" for a
  // coloured strip down the left instead.
  "hints": {
    "enabled": true,
    "font": "overused-grotesk",
    "fontSize": 28,
    "color": "#FFFFFF",
    "backgroundColor": "#0A0A0A",
    "backgroundOpacity": 1,
    "accent": "none",
    "accentColor": "#E6007E",
    "borderColor": null,
    "borderRadius": 14,
    "maxWidth": 520,
    "padding": 20,
    "position": "auto",
    "offset": 20,
    "fadeMs": 260
  },

  "captions": {
    "enabled": false,
    "font": "overused-grotesk",
    "fontSize": 34,
    "color": "#FFFFFF",
    "backgroundColor": "#0A0A0A",
    "backgroundOpacity": 0.72,
    "position": "bottom",
    "marginBottom": 60,
    "outline": true
  },

  "intro": {
    "enabled": true,
    "durationSec": 3,
    "backgroundGradient": ["#0A0A0A", "#1C0713"],
    // Drop the real logo in here and it appears above the title.
    // "logo": "assets/logo.png",
    "title": "Q Portal",
    "titleFont": "overused-grotesk-bold",
    "subtitle": "Your walkthrough",
    "subtitleFont": "overused-grotesk",
    "titleColor": "#FFFFFF",
    "subtitleColor": "#E6007E"
  },

  "outro": {
    "enabled": true,
    "durationSec": 3,
    "backgroundColor": "#0A0A0A",
    "title": "Questions?",
    "titleFont": "overused-grotesk-bold",
    "subtitle": "rebels.nl",
    "subtitleFont": "overused-grotesk",
    "titleColor": "#FFFFFF",
    "subtitleColor": "#E6007E"
  },

  // The page grey, so the opening does not flash white.
  "video": { "width": 1920, "height": 1080, "fps": 30, "backgroundColor": "#F4F5F7" }
}
